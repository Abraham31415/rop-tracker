# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rop_user:password@localhost:5432/rop_tracker

# ── Clinical JWT (used by nurses, coordinators, ophthalmologists) ─────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Admin panel credentials ───────────────────────────────────────────────────
# The email and password you use to log in at /sys-mgmt/login
ADMIN_EMAIL=admin@roptracker.ug
ADMIN_PASSWORD=change-this-minimum-20-characters-recommended

# Separate JWT secret for admin sessions only (do NOT reuse SECRET_KEY)
ADMIN_SESSION_SECRET=change-this-to-a-different-long-random-secret

# TOTP 2FA secret for Google Authenticator / Authy
# Leave blank on first run — the login page will show a QR code to scan.
# After scanning, copy the displayed secret here and restart the server.
ADMIN_TOTP_SECRET=

# Set to true in production (enables Secure cookies and HTTPS-only behaviour)
PRODUCTION=false

# ── Africa's Talking SMS gateway ──────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key
AT_SENDER_ID=ROPTRACK
# Set to false in production to actually send SMS messages
AT_SIMULATE=true

# ── WhatsApp Business API (optional) ─────────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ── SMTP for system alert emails (leave blank to disable) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
